{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": ["@iwf-web/tsconfig/react-strict/tsconfig.json"],
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "declaration": true, // Required by isolatedDeclarations (tsc --noEmit still emits nothing)
    "isolatedDeclarations": true // Ensure that each file can be safely transpiled without relying on other files
  }
}
